#!/bin/sh
# Start the Zaod desktop: labwc as the Wayland compositor, the Zaod panel on top.
#
# No Plasma, no KDE, no third-party shell. labwc supplies the window management
# (it is a compositor, not a desktop) and every surface the person sees - panel,
# launcher, app windows - is Zaod's own.
set -eu

export XDG_SESSION_TYPE=wayland
export XDG_CURRENT_DESKTOP=Zaod
export XDG_SESSION_DESKTOP=zaod
export XDG_MENU_PREFIX=zaod-
export ZAOD_THEME="${ZAOD_THEME:-dark}"
export QT_QPA_PLATFORM=wayland
export QT_QPA_PLATFORMTHEME=qt6ct
export GDK_BACKEND=wayland
export MOZ_ENABLE_WAYLAND=1
export _JAVA_AWT_WM_NONREPARENTING=1
# A live session runs from read-only media: keep every cache in RAM.
export XDG_CACHE_HOME="${XDG_CACHE_HOME:-$HOME/.cache}"

# A panel that fails to start must not take the session with it, but it must be
# reported where a person can see it if they open a terminal.
exec /usr/bin/labwc
