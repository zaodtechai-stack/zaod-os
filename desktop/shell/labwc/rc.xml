<?xml version="1.0"?>
<!-- labwc: the compositor under the Zaod desktop. Window management only. -->
<labwc_config>
  <core>
    <gap>0</gap>
    <adaptiveSync>no</adaptiveSync>
    <allowTearing>yes</allowTearing>
    <reuseOutputMode>yes</reuseOutputMode>
  </core>
  <theme>
    <name>Zaod</name>
    <cornerRadius>8</cornerRadius>
    <font place="ActiveWindow"><name>Inter</name><size>10</size><weight>bold</weight></font>
    <font place="InactiveWindow"><name>Inter</name><size>10</size></font>
    <font place="MenuItem"><name>Inter</name><size>10</size></font>
    <font place="OnScreenDisplay"><name>Inter</name><size>12</size></font>
  </theme>
  <!-- libinput defaults leave tap-to-click OFF, which on a laptop reads as
       "clicks do not work": tapping does nothing and a two-finger right click is
       never sent. Both are turned on for touchpads here. -->
  <libinput>
    <device category="touchpad">
      <tap>yes</tap>
      <tapButtonMap>left-right-middle</tapButtonMap>
      <clickMethod>buttonAreas</clickMethod>
      <naturalScroll>no</naturalScroll>
      <middleEmulation>yes</middleEmulation>
      <disableWhileTyping>yes</disableWhileTyping>
      <accelProfile>adaptive</accelProfile>
    </device>
    <device category="touch">
      <tap>yes</tap>
      <naturalScroll>no</naturalScroll>
    </device>
    <device category="mouse">
      <naturalScroll>no</naturalScroll>
      <accelProfile>adaptive</accelProfile>
    </device>
  </libinput>
  <keyboard>
    <default />
    <!-- Super+key opens something that exists: zaod-open resolves a launcher
         entry the same way the panel does. The old binds named app ids as
         commands ("org.zaod.terminal"), which is not a program and did nothing. -->
    <keybind key="W-Return"><action name="Execute" command="/usr/bin/foot" /></keybind>
    <keybind key="W-d"><action name="Execute" command="/usr/local/bin/zaod-open org.zaod.store" /></keybind>
    <keybind key="W-e"><action name="Execute" command="/usr/bin/thunar" /></keybind>
    <keybind key="W-c"><action name="Execute" command="/usr/local/bin/zaod-open org.zaod.control-center" /></keybind>
    <keybind key="W-s"><action name="Execute" command="/usr/local/bin/zaod-open org.zaod.studio" /></keybind>
    <keybind key="W-space"><action name="Execute" command="/usr/local/bin/zaod-open org.zaod.store" /></keybind>
    <!-- Print used to call a program the image did not contain -->
    <keybind key="Print"><action name="Execute" command="/usr/local/bin/zaod-screenshot" /></keybind>
    <keybind key="W-S-s"><action name="Execute" command="/usr/local/bin/zaod-screenshot --region" /></keybind>
    <keybind key="W-l"><action name="Execute" command="/usr/bin/swaylock -f -c 0b0d12" /></keybind>
    <keybind key="W-q"><action name="Close" /></keybind>
    <keybind key="W-Tab"><action name="NextWindow" /></keybind>
  </keyboard>
  <mouse>
    <default />
    <context name="Frame">
      <mousebind button="Left" action="Press"><action name="Focus" /></mousebind>
    </context>
  </mouse>
</labwc_config>
