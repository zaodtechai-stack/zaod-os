  "wallpapers": [
    {
      "id": "zaod-aurora",
      "name": "Zaod Aurora",
      "description": "Soft layered arcs over a deep blue field, original geometry.",
      "full": "Three radial glows, four concentric arcs, one scrim pass.",
      "flat": "Four concentric arcs on the background field, no glows, no scrim."
    },
    {
      "id": "zaod-lattice",
      "name": "Zaod Lattice",
      "description": "A 4 px-derived lattice of rounded cells that fades toward the edges.",
