{
  "meta": {
    "name": "Zaod Fluent",
    "version": "1.1.0",
    "phase": "0.6.1",
    "description": "Single source of truth for every Zaod OS surface: shell, applications, installer and login. Generated QML, GTK, Python and icon outputs are derived from this file only.",
    "grid": 4,
    "owner": "Zaod OS design system",
    "license": "CC-BY-4.0 for the design tokens, see desktop/design/LICENSE.md"
  },
  "spacing": {
    "0": 0,
    "1": 4,
    "2": 8,
    "3": 12,
    "4": 16,
    "5": 20,
    "6": 24,
    "7": 28,
    "8": 32,
    "10": 40,
    "12": 48,
    "16": 64,
    "20": 80,
    "24": 96
  },
  "radii": {
    "none": 0,
    "sm": 4,
    "md": 8,
    "lg": 12,
    "xl": 16,
    "xxl": 24,
    "pill": 999
  },
  "borders": {
    "hairline": 1,
    "thick": 2
  },
  "motion": {
    "fast": 120,
    "base": 160,
    "slow": 250,
    "easing": "cubic-bezier(0.2, 0, 0, 1)",
    "easingQml": "Easing.OutCubic"
  },
  "elevation": {
    "0": {
      "blur": 0,
      "y": 0,
      "opacity": 0.0
    },
    "1": {
      "blur": 4,
      "y": 1,
      "opacity": 0.08
    },
    "2": {
      "blur": 12,
      "y": 2,
      "opacity": 0.12
    },
    "3": {
      "blur": 24,
      "y": 6,
      "opacity": 0.16
    },
    "4": {
      "blur": 40,
      "y": 12,
      "opacity": 0.2
    }
  },
  "focus": {
    "ringWidth": 2,
    "ringOffset": 2,
    "minTargetSize": 32,
    "minPointerTarget": 28
  },
  "opacity": {
    "glass": 0.92,
    "scrim": 0.48,
    "hover": 0.08,
    "pressed": 0.12,
    "disabled": 0.45,
    "hint": 0.6
  },
  "layout": {
    "taskbarHeight": 44,
    "taskbarHeightLite": 40,
    "taskbarItemCount": 8,
    "startMenuWidth": 560,
    "startMenuHeight": 600,
    "quickSettingsWidth": 380,
    "notificationWidth": 400,
    "menuWidth": 256,
    "windowChromeHeight": 40,
    "windowMinWidth": 480,
    "windowMinHeight": 320,
    "iconNav": 24,
    "iconApp": 64,
    "iconGridCell": 96,
    "iconStartMenu": 28,
    "iconTaskbar": 20
  },
  "typography": {
    "families": {
      "text": "Inter",
      "display": "Inter",
      "mono": "JetBrains Mono",
      "fallback": "Noto Sans"
    },
    "licenses": {
      "Inter": "OFL-1.1",
      "JetBrains Mono": "OFL-1.1",
      "Noto Sans": "OFL-1.1"
    },
    "scaleRange": {
      "min": 100,
      "max": 150,
      "step": 25,
      "reflowAt": 125
    },
    "scale": [
      {
        "name": "caption",
        "size": 11,
        "lineHeight": 16,
        "weight": 400,
        "tracking": 0.2
      },
      {
        "name": "body-sm",
        "size": 12,
        "lineHeight": 16,
        "weight": 400,
        "tracking": 0.1
      },
      {
        "name": "body",
        "size": 14,
        "lineHeight": 20,
        "weight": 400,
        "tracking": 0.0
      },
      {
        "name": "body-strong",
        "size": 14,
        "lineHeight": 20,
        "weight": 600,
        "tracking": 0.0
      },
      {
        "name": "subtitle",
        "size": 16,
        "lineHeight": 24,
        "weight": 600,
        "tracking": 0.0
      },
      {
        "name": "title",
        "size": 20,
        "lineHeight": 28,
        "weight": 600,
        "tracking": -0.1
      },
      {
        "name": "title-lg",
        "size": 24,
        "lineHeight": 32,
        "weight": 600,
        "tracking": -0.2
      },
      {
        "name": "display",
        "size": 32,
        "lineHeight": 40,
        "weight": 600,
        "tracking": -0.4
      }
    ]
  },
  "elevationUsage": {
    "maxComponentLevel": 3,
    "levels": {
      "0": "In-flow surfaces that sit on a page: toolbars, list rows, inline forms, taskbar.",
      "1": "Cards and grouped containers that are part of the page, not above it.",
      "2": "Surfaces that float above the page: quick settings, notification centre, start menu, menus, tooltips.",
      "3": "Modal dialogs and the window frame of the focused window.",
      "4": "Reserved. No Zaod surface may use level 4; it exists only so the ladder has a documented ceiling."
    }
  },
  "motionUsage": {
    "fast": "Hover, press, focus ring, switch thumb, checkmark. Nothing larger than a 44 px thumb.",
    "base": "Panel open/close, disclosure, list insert/remove, progress determinacy.",
    "slow": "A whole surface entering or leaving: window restore, wallpaper crossfade, workspace switch.",
    "rules": [
      "Motion is feedback, not decoration: every animation must communicate a state change.",
      "Never animate on a timer longer than motionSlow, and never loop unless the state is genuinely indeterminate.",
      "Lite mode sets every duration to 0 and drops all Behaviour blocks; layout must not depend on them.",
      "Animate transform and opacity only. Never animate width, height, margins or anchors."
    ]
  },
  "accessibility": {
    "minTextContrast": 4.5,
    "minUiContrast": 3.0,
