  "lite": {
    "elevationCap": 1,
    "allowBlur": false,
    "allowGlass": false,
    "allowAnimation": false,
    "allowPreviews": false,
    "allowThumbnails": false,
    "wallpaperTier": "flat",
    "note": "Lite profile for 1366x768 / 2 GB / 2 cores: no blur, no glass, no animation, shadows capped at level 1, flat wallpaper tier. Text scale is never capped."
  },
