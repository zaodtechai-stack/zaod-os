{
  "meta": {
    "name": "Zaod Fluent",
    "version": "1.0.0",
    "phase": "0.6.0",
    "description": "Single source of truth for every Zaod OS surface: shell, applications, installer and login. Generated QML and GTK outputs are derived from this file only.",
    "grid": 4,
    "owner": "Zaod OS design system",
    "license": "CC-BY-4.0 for the design tokens, see desktop/design/LICENSE.md"
  },
  "spacing": {
    "0": 0,
    "1": 4,
    "2": 8,
    "3": 12,
    "4": 16,
    "5": 20,
    "6": 24,
    "7": 28,
    "8": 32,
    "10": 40,
    "12": 48,
    "16": 64,
    "20": 80,
    "24": 96
  },
  "radii": {
    "none": 0,
    "sm": 4,
    "md": 8,
    "lg": 12,
    "xl": 16,
    "xxl": 24,
    "pill": 999
  },
  "borders": {
    "hairline": 1,
    "thick": 2
  },
  "motion": {
    "fast": 120,
    "base": 160,
    "slow": 250,
    "easing": "cubic-bezier(0.2, 0, 0, 1)",
    "easingQml": "Easing.OutCubic"
  },
  "elevation": {
    "0": { "blur": 0, "y": 0, "opacity": 0.0 },
    "1": { "blur": 4, "y": 1, "opacity": 0.08 },
    "2": { "blur": 12, "y": 2, "opacity": 0.12 },
    "3": { "blur": 24, "y": 6, "opacity": 0.16 },
    "4": { "blur": 40, "y": 12, "opacity": 0.2 }
  },
  "focus": {
    "ringWidth": 2,
    "ringOffset": 2,
    "minTargetSize": 32
  },
  "typography": {
    "families": {
      "text": "Inter",
      "display": "Inter",
      "mono": "JetBrains Mono",
      "fallback": "Noto Sans"
    },
    "licenses": {
      "Inter": "OFL-1.1",
      "JetBrains Mono": "OFL-1.1",
      "Noto Sans": "OFL-1.1"
    },
    "scale": [
      { "name": "caption", "size": 11, "lineHeight": 16, "weight": 400, "tracking": 0.2 },
      { "name": "body-sm", "size": 12, "lineHeight": 16, "weight": 400, "tracking": 0.1 },
      { "name": "body", "size": 14, "lineHeight": 20, "weight": 400, "tracking": 0.0 },
      { "name": "body-strong", "size": 14, "lineHeight": 20, "weight": 600, "tracking": 0.0 },
      { "name": "subtitle", "size": 16, "lineHeight": 24, "weight": 600, "tracking": 0.0 },
      { "name": "title", "size": 20, "lineHeight": 28, "weight": 600, "tracking": -0.1 },
      { "name": "title-lg", "size": 24, "lineHeight": 32, "weight": 600, "tracking": -0.2 },
      { "name": "display", "size": 32, "lineHeight": 40, "weight": 600, "tracking": -0.4 }
    ]
  },
  "accessibility": {
    "minTextContrast": 4.5,
    "minUiContrast": 3.0,
    "pairs": [
      { "from": "textPrimary", "to": "background", "min": 4.5, "kind": "text" },
      { "from": "textPrimary", "to": "surface", "min": 4.5, "kind": "text" },
      { "from": "textPrimary", "to": "surfaceAlt", "min": 4.5, "kind": "text" },
      { "from": "textPrimary", "to": "surfaceRaised", "min": 4.5, "kind": "text" },
      { "from": "textSecondary", "to": "background", "min": 4.5, "kind": "text" },
      { "from": "textSecondary", "to": "surface", "min": 4.5, "kind": "text" },
      { "from": "textTertiary", "to": "surface", "min": 4.5, "kind": "text" },
      { "from": "onAccent", "to": "accent", "min": 4.5, "kind": "text" },
      { "from": "onAccent", "to": "accentHover", "min": 4.5, "kind": "text" },
      { "from": "onAccent", "to": "accentPressed", "min": 4.5, "kind": "text" },
      { "from": "accent", "to": "surface", "min": 4.5, "kind": "text" },
      { "from": "accent", "to": "accentSubtle", "min": 4.5, "kind": "text" },
      { "from": "danger", "to": "surface", "min": 4.5, "kind": "text" },
      { "from": "onDanger", "to": "danger", "min": 4.5, "kind": "text" },
      { "from": "success", "to": "surface", "min": 4.5, "kind": "text" },
      { "from": "warning", "to": "surface", "min": 4.5, "kind": "text" },
      { "from": "border", "to": "surface", "min": 3.0, "kind": "ui" },
      { "from": "border", "to": "background", "min": 3.0, "kind": "ui" },
      { "from": "borderStrong", "to": "surface", "min": 3.0, "kind": "ui" },
      { "from": "focusRing", "to": "surface", "min": 3.0, "kind": "ui" },
      { "from": "focusRing", "to": "background", "min": 3.0, "kind": "ui" }
    ]
  },
  "themes": {
    "light": {
      "background": "#F6F7F9",
      "surface": "#FFFFFF",
      "surfaceAlt": "#EEF1F5",
      "surfaceRaised": "#FFFFFF",
      "surfaceOverlay": "#FFFFFF",
      "border": "#848D9A",
      "borderStrong": "#5F6875",
      "textPrimary": "#101418",
      "textSecondary": "#4A5260",
      "textTertiary": "#5F6875",
      "textDisabled": "#8A93A0",
      "accent": "#0067C0",
      "accentHover": "#005BA8",
      "accentPressed": "#004F91",
      "accentSubtle": "#E6F0FB",
      "onAccent": "#FFFFFF",
      "danger": "#B3261E",
      "onDanger": "#FFFFFF",
      "success": "#1B6B3A",
      "warning": "#7A5900",
      "focusRing": "#0067C0",
      "shadow": "#0B1B2B",
      "scrim": "#0B1B2B"
    },
    "dark": {
      "background": "#14161A",
      "surface": "#1B1E23",
      "surfaceAlt": "#23272E",
      "surfaceRaised": "#282D35",
      "surfaceOverlay": "#2E343D",
      "border": "#626C7B",
      "borderStrong": "#8A93A0",
      "textPrimary": "#F2F4F7",
      "textSecondary": "#B4BCC8",
      "textTertiary": "#9CA6B3",
      "textDisabled": "#6C7684",
      "accent": "#4CC2FF",
      "accentHover": "#6BCEFF",
      "accentPressed": "#8AD8FF",
      "accentSubtle": "#16303F",
      "onAccent": "#101418",
      "danger": "#FFB4AB",
      "onDanger": "#3B0906",
      "success": "#7DDC9B",
      "warning": "#F5C451",
      "focusRing": "#4CC2FF",
      "shadow": "#000000",
      "scrim": "#000000"
    }
  },
  "wallpapers": [
    {
      "id": "zaod-aurora",
      "name": "Zaod Aurora",
      "description": "Soft layered arcs over a deep blue field, original geometry."
    },
    {
      "id": "zaod-lattice",
      "name": "Zaod Lattice",
      "description": "A 4 px-derived lattice of rounded cells that fades toward the edges."
    },
    {
      "id": "zaod-horizon",
      "name": "Zaod Horizon",
      "description": "A horizon line with stacked translucent bands, calm and low contrast."
    }
  ]
}
