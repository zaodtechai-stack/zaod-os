{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zaod.os/spec/store-index.schema.json",
  "title": "Zaod store index v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "name", "generated", "packages"],
  "properties": {
    "format": { "const": 1 },
    "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$", "maxLength": 64 },
    "generated": { "type": "string", "minLength": 10, "maxLength": 40 },
    "packages": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "version", "kind", "arch", "min_os", "summary", "license", "author", "size", "sha256", "filename"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+$", "maxLength": 128 },
          "name": { "type": "string", "minLength": 1, "maxLength": 64 },
          "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
          "kind": { "enum": ["app", "runtime", "theme", "project", "system-update"] },
          "arch": { "const": "x86_64" },
          "min_os": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
          "summary": { "type": "string", "minLength": 4, "maxLength": 120 },
          "description": { "type": "string", "maxLength": 4000 },
          "categories": { "type": "array", "items": { "type": "string" }, "maxItems": 8 },
          "license": { "type": "object" },
          "author": { "type": "object" },
          "permissions": { "type": "object" },
          "runtimes": { "type": "array", "items": { "type": "string" } },
          "size": { "type": "integer", "minimum": 1 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "filename": { "type": "string", "minLength": 5, "maxLength": 200 },
          "url": { "type": "string", "maxLength": 400 }
        }
      }
    }
  }
}
