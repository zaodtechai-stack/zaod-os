{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://zaod.os/spec/os-release-feed-v1.schema.json",
  "title": "Zaod OS update feed, format 1",
  "type": "object",
  "required": ["format_version", "generated", "expires", "releases", "signature"],
  "additionalProperties": false,
  "properties": {
    "format_version": {"const": 1},
    "generated": {"type": "string", "format": "date-time"},
    "expires": {"type": "string", "format": "date-time"},
    "releases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["version", "channel", "sha256", "iso_url", "size"],
        "additionalProperties": false,
        "properties": {
          "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+([-+][0-9A-Za-z.-]+)?$"},
          "channel": {"enum": ["stable", "beta", "lts"]},
          "status": {"enum": ["draft", "published", "paused", "archived"]},
          "iso_url": {"type": "string", "pattern": "^https://"},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "size": {"type": "integer", "minimum": 0},
          "min_supported_version": {"type": "string"},
          "rollout_percent": {"type": "integer", "minimum": 0, "maximum": 100},
          "blocker": {"type": "boolean"},
          "notes_url": {"type": "string"}
        }
      }
    },
    "signature": {
      "type": "object",
      "required": ["algorithm", "key_id", "value"],
      "additionalProperties": false,
      "properties": {
        "algorithm": {"const": "ed25519"},
        "key_id": {"type": "string", "pattern": "^[0-9a-f]{16}$"},
        "value": {"type": "string", "pattern": "^[0-9a-f]{128}$"}
      }
    }
  }
}
