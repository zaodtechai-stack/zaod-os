#!/bin/sh
# Zaod live-boot logic.
#
# Runs as a child of /init (PID 1), never as PID 1 itself. Anything in here may
# fail; a failure has to be a message on the screen and a rescue shell, not
# "Kernel panic - not syncing: Attempted to kill init".
#
#   1. load the drivers the media needs
#   2. parse the zaod.* kernel parameters
#   3. find the media carrying the ZAODOS volume label
#   4. loop-mount the squashfs read-only and stack a tmpfs write layer on top
#   5. mark the live root ready; /init does the switch_root
#
# Deliberately no `set -e`: an unguarded command that failed used to exit PID 1
# and panic the machine. Every step here checks its own result and reports it
# through fail(), so the screen always says which step stopped the boot.

LABEL="ZAODOS"
SQUASHFS="zaod-os-x86_64.squashfs"
SQUASH_DIR="/boot/zaod"
MEDIA=""
RD="${STATE_DIR:-/run/zaod-init}"
LIVE_ROOT="$RD/lower"
OVERLAY_ROOT="$RD/upper"
NEW_ROOT="${NEW_ROOT:-/newroot}"
MEDIA_MOUNT="$RD/media"
SCREEN="${SCREEN:-/dev/tty0}"

# What the boot is doing right now. The exit trap prints it, so a screen photo
# is enough to see which step died and why.
STEP="starting"

say() {
  message="$(printf '\033[1;36m[zaod]\033[0m %s' "$*")"
  printf '%s\n' "$message"
  screen_write "$message"
  return 0
}

screen_write() {
  [ -n "$SCREEN" ] || return 0
  [ -c "$SCREEN" ] || return 0
  printf '%s\n' "$*" > "$SCREEN" 2>/dev/null || true
  return 0
}

fail() {
  message="$(printf '\033[1;31m[zaod] boot stopped during "%s": %s\033[0m' "$STEP" "$*")"
  printf '%s\n' "$message" >&2
  screen_write "[zaod] boot stopped during \"$STEP\": $*"
  exit 1
}

# A diagnostic, not a control path: /init turns this into a rescue shell.
# shellcheck disable=SC2154
trap 'code=$?; if [ "$code" -ne 0 ]; then printf "[zaod] boot logic exited with status %s during \"%s\"\n" "$code" "$STEP" >&2; fi' EXIT

TORAM=0
RESCUE=0
SAFEGFX=0
INSTALLER=0

# --- load the boot stack ----------------------------------------------------
# The kernel autoloads a module by running /sbin/modprobe, which only exists
# once the initramfs provides it, so squashfs, loop or overlay left to autoload
# made `mount` fail. A module that is built in, or simply absent, is not an
# error here: the mount that needs it reports its own failure.
STEP="loading the media drivers"
for module in loop squashfs overlay isofs nls_cp437 nls_iso8859-1 nls_utf8 \
              vfat fat sr_mod cdrom sd_mod libata ata_piix ahci virtio_blk \
              usb-storage uas xhci-hcd xhci-pci ehci-hcd ehci-pci ohci-hcd \
              ohci-pci uhci-hcd usbhid hid-generic; do
  modprobe "$module" 2>/dev/null || true
done

# --- kernel parameters ------------------------------------------------------
STEP="reading the kernel command line"
if [ -r /proc/cmdline ]; then
  # Word-splitting the kernel command line is exactly what is wanted here.
  # shellcheck disable=SC2013
  for parameter in $(cat /proc/cmdline); do
    case "$parameter" in
      zaod.live=*) : ;;
      zaod.toram=1) TORAM=1 ;;
      zaod.rescue=1) RESCUE=1 ;;
      zaod.safegfx=1) SAFEGFX=1 ;;
      zaod.installer=1) INSTALLER=1 ;;
      zaod.root=*) MEDIA="${parameter#zaod.root=}" ;;
      zaod.media=*) MEDIA="${parameter#zaod.media=}" ;;
      root=live:LABEL=*) LABEL="${parameter##*LABEL=}" ;;
    esac
  done
else
  say "no /proc/cmdline; using the compiled defaults"
fi

if [ "$SAFEGFX" -eq 1 ]; then
  say "safe graphics requested: kernel modesetting stays off"
fi

STEP="preparing the live workspace"
mkdir -p "$RD" "$LIVE_ROOT" "$OVERLAY_ROOT" "$NEW_ROOT" "$MEDIA_MOUNT" \
  || fail "cannot create the live workspace under $RD"
mount -t tmpfs -o mode=0755 tmpfs "$OVERLAY_ROOT" \
  || fail "cannot create the temporary overlay write layer"
mkdir -p "$OVERLAY_ROOT/upper" "$OVERLAY_ROOT/work" \
  || fail "cannot create the overlay upper/work directories"

# --- locate the media -------------------------------------------------------
# An ISO9660 volume has its primary volume descriptor at byte 32768 and 'CD001'
# at 32769. Reading one 2048-byte sector identifies a disc without mounting
# every disk in the machine. A hybrid image can also expose the same volume one
# partition further in, so the next descriptor is checked too. Sector-sized
# reads matter on real hardware: skipping 32769 bytes with bs=1 is 32769 single
# byte reads from a USB stick.
has_iso_marker() {
  device="$1"
  [ -n "$device" ] || return 1
  [ -b "$device" ] || return 1
  for sector in 16 20; do
    if dd if="$device" bs=2048 skip="$sector" count=1 2>/dev/null \
       | dd bs=1 skip=1 count=5 2>/dev/null | grep -q CD001; then
      return 0
    fi
  done
  return 1
}

# A device is the boot media when it mounts read-only and carries the image at
# the expected path. The volume label is a hint, not a requirement: the busybox
# blkid in this image cannot read an iso9660 label, so trusting it alone meant a
# correctly built disc never booted.
try_media() {
  device="$1"
  [ -n "$device" ] || return 1
  [ -b "$device" ] || return 1
  if mount -t iso9660 -o ro,nolock "$device" "$MEDIA_MOUNT" 2>/dev/null \
     || mount -t vfat -o ro "$device" "$MEDIA_MOUNT" 2>/dev/null \
     || mount -o ro "$device" "$MEDIA_MOUNT" 2>/dev/null; then
    if [ -f "$MEDIA_MOUNT$SQUASH_DIR/$SQUASHFS" ]; then
      return 0
    fi
    umount "$MEDIA_MOUNT" 2>/dev/null || true
  fi
  return 1
}

# Every block device the kernel registered, taken from sysfs rather than a
# hardcoded list: a stick behind a hub, an SD card, an NVMe enclosure or a card
# reader all show up under a name this script never had to guess.
partitions_of() {
  for partition in /sys/class/block/"$1"/"$1"* /sys/class/block/"$1"/"${1}p"*; do
    [ -e "$partition" ] || continue
    printf '/dev/%s\n' "${partition##*/}"
  done
  return 0
}

removable_devices() {
  for sysdev in /sys/class/block/*; do
    [ -e "$sysdev" ] || continue
    name="${sysdev##*/}"
    case "$name" in
      loop* | ram* | zram* | dm-* | md*) continue ;;
    esac
    case "$(cat "/sys/class/block/$name/removable" 2>/dev/null || echo 0)" in
      1)
        printf '/dev/%s\n' "$name"
        partitions_of "$name"
        ;;
    esac
  done
  return 0
}

optical_devices() {
  for sysdev in /sys/class/block/*; do
    [ -e "$sysdev" ] || continue
    case "${sysdev##*/}" in
      sr*) printf '/dev/%s\n' "${sysdev##*/}" ;;
    esac
  done
  return 0
}

other_devices() {
  for sysdev in /sys/class/block/*; do
    [ -e "$sysdev" ] || continue
    name="${sysdev##*/}"
    case "$name" in
      loop* | ram* | zram* | dm-* | md* | sr*) continue ;;
    esac
    printf '/dev/%s\n' "$name"
    partitions_of "$name"
  done
  return 0
}

append_unique() {
  case " $1 " in
    *" $2 "*) printf '%s' "$1" ;;
    *) printf '%s %s' "$1" "$2" ;;
  esac
}

REMOVABLE_CANDIDATES=""
OTHER_CANDIDATES=""
scan_devices() {
  REMOVABLE_CANDIDATES=""
  OTHER_CANDIDATES=""
  for device in /dev/disk/by-label/"$LABEL" $(removable_devices) $(optical_devices); do
    [ -b "$device" ] || continue
    REMOVABLE_CANDIDATES="$(append_unique "$REMOVABLE_CANDIDATES" "$device")"
  done
  for device in $(other_devices); do
    [ -b "$device" ] || continue
    case " $REMOVABLE_CANDIDATES " in
      *" $device "*) continue ;;
    esac
    OTHER_CANDIDATES="$(append_unique "$OTHER_CANDIDATES" "$device")"
  done
  return 0
}

# What the machine actually has, printed when nothing matched. Without this the
# screen shows a row of identical "waiting" lines and no way to tell a missing
# kernel driver from an empty card reader.
dump_media_state() {
  say "kernel: $(uname -r)"
  say "block devices registered: $(ls /sys/class/block 2>/dev/null | tr '\n' ' ')"
  if [ -r /proc/partitions ]; then
    say "partitions: $(awk 'NR>2 {printf "%s ", $4}' /proc/partitions)"
  fi
  say "last usb/scsi/ata lines from the kernel log:"
  dmesg 2>/dev/null | grep -iE 'usb|scsi|ata[0-9]|sd [0-9]|sr [0-9]|xhci|mmc' \
    | tail -n 12 | while IFS= read -r line; do say "  $line"; done
  return 0
}

wait_for_media() {
  attempt=0
  while [ "$attempt" -lt 45 ]; do
    scan_devices
    # Fast pass: every device carrying an ISO9660 volume descriptor.
    for candidate in $REMOVABLE_CANDIDATES $OTHER_CANDIDATES; do
      has_iso_marker "$candidate" || continue
      if try_media "$candidate"; then
        MEDIA="$candidate"
        return 0
      fi
    done
    # Slow pass: a mount test on the likely devices that showed no marker, which
    # covers a FAT-formatted stick or a layout the marker check does not know.
    for candidate in $REMOVABLE_CANDIDATES; do
      if try_media "$candidate"; then
        MEDIA="$candidate"
        return 0
      fi
    done
    attempt=$((attempt + 1))
    if [ "$attempt" -eq 1 ]; then
      say "waiting for the $LABEL media (up to 45 s)"
      say "candidates so far: removable[$REMOVABLE_CANDIDATES] other[$OTHER_CANDIDATES]"
    fi
    # A short heartbeat, so a screenshot after a few seconds already shows what
    # the machine sees instead of one frozen line.
    if [ "$attempt" -eq 5 ] || [ "$attempt" -eq 20 ]; then
      say "still looking ($attempt/45): block devices $(ls /sys/class/block 2>/dev/null | tr '\n' ' ')"
    fi
    # A device that appears late - a hub powering up, a controller that needs a
    # rescan - is exactly what the retry window is for.
    if [ "$attempt" -eq 10 ] || [ "$attempt" -eq 25 ]; then
      if [ -w /sys/bus/pci/rescan ]; then
        echo 1 > /sys/bus/pci/rescan 2>/dev/null || true
      fi
      for module in usb-storage sd_mod sr_mod xhci-hcd xhci-pci ehci-hcd ahci; do
        modprobe "$module" 2>/dev/null || true
      done
    fi
    sleep 1
  done
  return 1
}

STEP="finding the ZAODOS media"
if [ -n "$MEDIA" ]; then
  say "using the media given on the kernel command line: $MEDIA"
  try_media "$MEDIA" || fail "cannot mount $MEDIA read-only or it has no $SQUASH_DIR/$SQUASHFS"
else
  if ! wait_for_media; then
    STEP="waiting for the boot media"
    dump_media_state
    fail "cannot find the $LABEL boot media"
  fi
fi

say "using boot media $MEDIA"

STEP="checking the image on the boot media"
SQUASH_PATH="${MEDIA_MOUNT}${SQUASH_DIR}/${SQUASHFS}"
[ -f "$SQUASH_PATH" ] || fail "missing $SQUASH_PATH on the boot media"
say "squashfs: $SQUASH_PATH ($(du -h "$SQUASH_PATH" 2>/dev/null | cut -f1))"

# --- copy to RAM when asked -------------------------------------------------
if [ "$TORAM" -eq 1 ]; then
  STEP="copying the image to RAM"
  available_kb=$(awk '/MemTotal/ {print $2}' /proc/meminfo)
  needed_kb=$(( $(du -k "$SQUASH_PATH" | cut -f1) * 2 ))
  if [ "$available_kb" -lt "$needed_kb" ]; then
    fail "zaod.toram=1 needs about $((needed_kb / 1024)) MB of RAM, this machine has $((available_kb / 1024)) MB"
  fi
  say "copying the image to RAM"
  cp "$SQUASH_PATH" "$RD/ram.squashfs" || fail "cannot copy the image to RAM"
  SQUASH_PATH="$RD/ram.squashfs"
fi

# --- mount the image read-only and stack a writable layer -------------------
STEP="mounting the live image"
mount -t squashfs -o ro,loop "$SQUASH_PATH" "$LIVE_ROOT" || fail "cannot mount $SQUASH_PATH"

say "stacking a tmpfs write layer (nothing is written to the media)"
STEP="stacking the writable layer"
OVERLAY_ACTIVE=1
mount -t overlay overlay \
  -o "lowerdir=$LIVE_ROOT,upperdir=$OVERLAY_ROOT/upper,workdir=$OVERLAY_ROOT/work" \
  "$NEW_ROOT" || {
    say "overlayfs unavailable; continuing with a read-only live root"
    mount --bind "$LIVE_ROOT" "$NEW_ROOT" || fail "cannot bind the read-only live root"
    OVERLAY_ACTIVE=0
  }

STEP="preparing the live system"
mount -t tmpfs -o mode=0755 tmpfs "$NEW_ROOT/run" \
  || fail "cannot create a writable /run for the live system"
mkdir -p "$NEW_ROOT/run/zaod/lower" "$NEW_ROOT/run/zaod/upper" \
  || fail "cannot create the live state directories"
if [ "$OVERLAY_ACTIVE" -eq 1 ]; then
  mount --move "$LIVE_ROOT" "$NEW_ROOT/run/zaod/lower" \
    || fail "cannot preserve the read-only live image mount"
  mount --move "$OVERLAY_ROOT" "$NEW_ROOT/run/zaod/upper" \
    || fail "cannot preserve the live write layer"
fi

if [ "$RESCUE" -eq 1 ]; then
  say "rescue mode: starting a shell inside the live root"
fi
if [ "$INSTALLER" -eq 1 ]; then
  say "installer mode: the session will start the installer"
  echo installer > "$NEW_ROOT/run/zaod/boot-mode" || fail "cannot record installer mode"
fi
if [ "$SAFEGFX" -eq 1 ]; then
  echo safegfx > "$NEW_ROOT/run/zaod/boot-mode" || fail "cannot record safe-graphics mode"
fi

STEP="keeping the boot off the boot media"
# A live boot has two jobs: mount the image, and reach the desktop. Two units in
# the image work against the second one on the media people actually boot from:
#
#   ldconfig.service rebuilds /etc/ld.so.cache by reading the ELF header of
#   every library in the image - 3898 of them here - straight off the squashfs
#   on a USB stick. The unit carries no timeout, so the boot sits in
#   "Job ldconfig.service/start running (no limit)" for minutes and looks hung;
#   iso-29 was reported frozen at exactly that point six times. The cache the
#   image ships is already correct, and a read-only live root cannot change its
#   libraries, so the rebuild has nothing to discover. Masked.
#
#   plymouth-* want to paint a splash this image boots without, and
#   plymouth-quit-wait (TimeoutSec=0) waits for a splash that never runs.
#
# A mask is a symlink to /dev/null in /etc/systemd/system, which the overlay
# keeps in the tmpfs write layer, so the boot media is still never written to.
if [ "$OVERLAY_ACTIVE" -eq 1 ]; then
  mkdir -p "$NEW_ROOT/etc/systemd/system" || fail "cannot prepare the live unit masks"
  for unit in ldconfig.service plymouth-start.service plymouth-quit.service \
              plymouth-quit-wait.service plymouth-read-write.service; do
    ln -sf /dev/null "$NEW_ROOT/etc/systemd/system/$unit" \
      || fail "cannot mask $unit for the live session"
  done
  say "masked ldconfig and plymouth: the live root needs neither"
  # Ctrl+Alt+F2 must always be a way into a live stick. The wizard owns tty1
  # and the display manager takes it over afterwards, so a second getty is the
  # one path that exists even when neither can take the console.
  mkdir -p "$NEW_ROOT/etc/systemd/system/getty.target.wants" \
    || fail "cannot prepare the live rescue console"
  ln -sf /usr/lib/systemd/system/getty@.service \
    "$NEW_ROOT/etc/systemd/system/getty.target.wants/getty@tty2.service" \
    || fail "cannot enable the live rescue console"
else
  say "read-only live root: ldconfig and plymouth cannot be masked"
fi

STEP="checking the live system's init"
[ -x "$NEW_ROOT/sbin/init" ] || fail "the live image has no executable /sbin/init"

# Everything the supervisor needs to know, in one file: it will not switch_root
# without it, so a half-mounted live root can never be handed over.
printf 'media=%s\nkernel=%s\n' "$MEDIA" "$(uname -r)" > "$RD/boot-ready" \
  || fail "cannot record a ready live root"

STEP="ready"
say "live root ready on $NEW_ROOT (media $MEDIA)"
exit 0
