#!/bin/sh
# Zaod live-boot init. Runs as PID 1 inside the initramfs.
#
# 1. parse the zaod.* kernel parameters
# 2. find the media carrying the ZAODOS volume label
# 3. loop-mount the squashfs read-only and stack a tmpfs write layer on top
# 4. switch_root into the live system
#
# Every failure path drops to a rescue shell that is reopened forever, so PID 1
# can never exit. An exiting PID 1 is a kernel panic ("Attempted to kill init")
# that tells the person in front of the machine nothing at all, and that is the
# failure this script must never produce again.

set -eu

LABEL="ZAODOS"
SQUASHFS="zaod-os-x86_64.squashfs"
SQUASH_DIR="/boot/zaod"
MEDIA=""
RD="/run/zaod-init"
LIVE_ROOT="$RD/lower"
OVERLAY_ROOT="$RD/upper"
NEW_ROOT="/newroot"

# /dev/console is the *last* console= on the kernel command line, which on this
# image is ttyS0. On a laptop with no serial port every message this script
# prints is therefore invisible - and so is the rescue shell, which is how a
# missing driver turned into an unexplained "Attempted to kill init" panic.
# Mirror everything to the machine's own screen as well.
SCREEN=/dev/tty0

say() {
  message="$(printf '\033[1;36m[zaod]\033[0m %s' "$*")"
  printf '%s\n' "$message"
  # A serial-only machine has no /dev/tty0; that must never fail the boot.
  if [ -c "$SCREEN" ]; then
    printf '%s\n' "$message" > "$SCREEN" 2>/dev/null || true
  fi
  return 0
}

screen_write() {
  [ -c "$SCREEN" ] || return 0
  printf '%s\n' "$*" > "$SCREEN" 2>/dev/null || true
  return 0
}

# Never returns. The shell is reopened instead of exec'd, so a shell that exits
# immediately (an unreadable console, a stray EOF) cannot take PID 1 with it.
rescue() {
  attempts=0
  while :; do
    attempts=$((attempts + 1))
    if [ "$attempts" -eq 1 ]; then
      printf 'Dropping to a rescue shell. Nothing was written to the boot media.\n'
      screen_write 'Dropping to a rescue shell. Nothing was written to the boot media.'
      screen_write 'Type "exit" to reopen this shell; the machine stays alive either way.'
    else
      printf '[zaod] rescue shell closed; reopening it (PID 1 must not exit)\n'
      screen_write '[zaod] rescue shell closed; reopening it. Press Enter.'
      sleep 1
    fi
    # Opened for writing on stdin as well: reading a VT that is nobody's
    # controlling terminal can fail, and a shell with a dead stdin exits.
    if [ -c "$SCREEN" ]; then
      /bin/sh < "$SCREEN" > "$SCREEN" 2>&1 || true
    else
      /bin/sh || true
    fi
  done
}

fail() {
  message="$(printf '\033[1;31m[zaod] %s\033[0m' "$*")"
  printf '%s\n' "$message" >&2
  for device in "$SCREEN" /dev/console; do
    [ -w "$device" ] || continue
    printf '%s\n' "$message" > "$device" 2>/dev/null || true
  done
  trap - EXIT
  rescue
}

# A signal sent to PID 1 must not end the boot either.
trap 'say "received a termination signal; staying alive"' INT TERM HUP QUIT
# PID 1 exiting is a kernel panic that explains nothing. Any error that slips
# past a check lands here instead, with the line number.
trap 'fail "unexpected failure while booting (line $LINENO)"' EXIT

TORAM=0
RESCUE=0
SAFEGFX=0
INSTALLER=0

mount -t devtmpfs -o mode=0755 devtmpfs /dev 2>/dev/null || true
mount -t proc proc /proc || fail "cannot mount proc"
mount -t sysfs sysfs /sys || fail "cannot mount sysfs"
# Load the boot stack by name. The kernel autoloads a module by running
# /sbin/modprobe, which only exists once this initramfs provides it, so leaving
# squashfs, loop or overlay to autoload made `mount` fail and dropped the boot
# into the rescue shell. A module that is built in, or simply absent, is not an
# error here: the mount that needs it reports its own failure.
for module in loop squashfs overlay isofs nls_cp437 nls_iso8859-1 nls_utf8 \
              vfat fat sr_mod cdrom sd_mod libata ata_piix ahci virtio_blk \
              usb-storage uas xhci-hcd xhci-pci ehci-hcd ehci-pci ohci-hcd \
              ohci-pci uhci-hcd usbhid hid-generic; do
  modprobe "$module" 2>/dev/null || true
done

# Word-splitting the kernel command line is exactly what is wanted here.
# shellcheck disable=SC2013
for parameter in $(cat /proc/cmdline); do
  case "$parameter" in
    zaod.live=*) : ;;
    zaod.toram=1) TORAM=1 ;;
    zaod.rescue=1) RESCUE=1 ;;
    zaod.safegfx=1) SAFEGFX=1 ;;
    zaod.installer=1) INSTALLER=1 ;;
    zaod.root=*) MEDIA="${parameter#zaod.root=}" ;;
    root=live:LABEL=*) LABEL="${parameter##*LABEL=}" ;;
  esac
done

[ "$SAFEGFX" -eq 1 ] && say "safe graphics requested: kernel modesetting stays off"

mkdir -p "$RD"
mount -t tmpfs -o mode=0755 tmpfs "$RD" || fail "cannot create temporary live workspace"
mkdir -p "$LIVE_ROOT" "$OVERLAY_ROOT" "$NEW_ROOT"
mount -t tmpfs -o mode=0755 tmpfs "$OVERLAY_ROOT" \
  || fail "cannot create temporary overlay write layer"
mkdir -p "$OVERLAY_ROOT/upper" "$OVERLAY_ROOT/work"

# --- locate the media -------------------------------------------------------
MEDIA_MOUNT="/run/zaod/media"
mkdir -p "$MEDIA_MOUNT"

# An ISO9660 volume has its primary volume descriptor at byte 32768, and the
# identifier 'CD001' sits at 32769. Reading five bytes there identifies a disc
# without mounting every disk in the machine, so an encrypted or journalled
# filesystem is never touched just because it happened to be attached. A hybrid
# image also exposes the same volume one partition further in (this build uses a
# 16-sector partition offset, 8192 bytes), so both places are checked.
has_iso_marker() {
  device="$1"
  [ -b "$device" ] || return 1
  for skip in 32769 40961; do
    if dd if="$device" bs=1 skip="$skip" count=5 2>/dev/null | grep -q CD001; then
      return 0
    fi
  done
  return 1
}

# A device is the boot media when it mounts read-only and carries the image at
# the expected path. The volume label is a hint, not a requirement: the busybox
# blkid in this image cannot read an iso9660 label, so trusting it alone meant a
# correctly built disc never booted. Mounting and checking for the image is the
# test that cannot give a false negative.
try_media() {
  device="$1"
  [ -n "$device" ] || return 1
  [ -b "$device" ] || return 1
  if mount -t iso9660 -o ro "$device" "$MEDIA_MOUNT" 2>/dev/null \
     || mount -t vfat -o ro "$device" "$MEDIA_MOUNT" 2>/dev/null \
     || mount -t auto -o ro "$device" "$MEDIA_MOUNT" 2>/dev/null; then
    if [ -f "$MEDIA_MOUNT$SQUASH_DIR/$SQUASHFS" ]; then
      return 0
    fi
    umount "$MEDIA_MOUNT" 2>/dev/null || true
  fi
  return 1
}

# Every block device the kernel registered, taken from sysfs rather than a
# hardcoded list: a stick behind a hub, an SD card, an NVMe enclosure or a card
# reader all show up under a name this script never had to guess.
partitions_of() {
  for partition in /sys/class/block/"$1"/"$1"* /sys/class/block/"$1"/"${1}p"*; do
    [ -e "$partition" ] || continue
    printf '/dev/%s\n' "${partition##*/}"
  done
}

removable_devices() {
  for sysdev in /sys/class/block/*; do
    [ -e "$sysdev" ] || continue
    name="${sysdev##*/}"
    case "$name" in
      loop* | ram* | zram* | dm-* | md*) continue ;;
    esac
    case "$(cat "/sys/class/block/$name/removable" 2>/dev/null || echo 0)" in
      1)
        printf '/dev/%s\n' "$name"
        partitions_of "$name"
        ;;
    esac
  done
}

optical_devices() {
  for sysdev in /sys/class/block/*; do
    [ -e "$sysdev" ] || continue
    name="${sysdev##*/}"
    case "$name" in
      sr*) printf '/dev/%s\n' "$name" ;;
    esac
  done
}

other_devices() {
  for sysdev in /sys/class/block/*; do
    [ -e "$sysdev" ] || continue
    name="${sysdev##*/}"
    case "$name" in
      loop* | ram* | zram* | dm-* | md* | sr*) continue ;;
    esac
    printf '/dev/%s\n' "$name"
    partitions_of "$name"
  done
}

append_unique() {
  # $1 list, $2 device -> prints the list with the device appended once
  case " $1 " in
    *" $2 "*) printf '%s' "$1" ;;
    *) printf '%s %s' "$1" "$2" ;;
  esac
}

REMOVABLE_CANDIDATES=""
OTHER_CANDIDATES=""
scan_devices() {
  REMOVABLE_CANDIDATES=""
  OTHER_CANDIDATES=""
  for device in /dev/disk/by-label/"$LABEL" $(removable_devices) $(optical_devices); do
    [ -b "$device" ] || continue
    REMOVABLE_CANDIDATES="$(append_unique "$REMOVABLE_CANDIDATES" "$device")"
  done
  for device in $(other_devices); do
    [ -b "$device" ] || continue
    case " $REMOVABLE_CANDIDATES " in
      *" $device "*) continue ;;
    esac
    OTHER_CANDIDATES="$(append_unique "$OTHER_CANDIDATES" "$device")"
  done
}

# What the machine actually has, printed when nothing matched. Without this the
# screen shows a row of identical "waiting" lines and no way to tell a missing
# kernel driver from an empty card reader.
dump_media_state() {
  say "kernel: $(uname -r)"
  say "block devices registered: $(ls /sys/class/block 2>/dev/null | tr '\n' ' ')"
  if [ -r /proc/partitions ]; then
    say "partitions: $(awk 'NR>2 {printf "%s ", $4}' /proc/partitions)"
  fi
  say "last usb/scsi/ata lines from the kernel log:"
  dmesg 2>/dev/null | grep -iE 'usb|scsi|ata[0-9]|sd [0-9]|sr [0-9]|xhci|mmc' \
    | tail -n 12 | while IFS= read -r line; do say "  $line"; done
  return 0
}

wait_for_media() {
  attempt=0
  while [ "$attempt" -lt 45 ]; do
    scan_devices
    # Fast pass: every device carrying an ISO9660 volume descriptor.
    for candidate in $REMOVABLE_CANDIDATES $OTHER_CANDIDATES; do
      has_iso_marker "$candidate" || continue
      if try_media "$candidate"; then
        MEDIA="$candidate"
        return 0
      fi
    done
    # Slow pass: a mount test on the likely devices that showed no marker, which
    # covers a FAT-formatted stick or a layout the marker check does not know.
    for candidate in $REMOVABLE_CANDIDATES; do
      if try_media "$candidate"; then
        MEDIA="$candidate"
        return 0
      fi
    done
    attempt=$((attempt + 1))
    if [ "$attempt" -eq 1 ]; then
      say "waiting for the $LABEL media (up to 45 s)"
    fi
    # A device that appears late - a hub powering up, a controller that needs a
    # rescan - is exactly what the retry window is for.
    if [ "$attempt" -eq 10 ] || [ "$attempt" -eq 25 ]; then
      [ -w /sys/bus/pci/rescan ] && echo 1 > /sys/bus/pci/rescan 2>/dev/null || true
      for module in usb-storage sd_mod sr_mod xhci-hcd xhci-pci ehci-hcd ahci; do
        modprobe "$module" 2>/dev/null || true
      done
    fi
    sleep 1
  done
  return 1
}

if [ -n "$MEDIA" ]; then
  try_media "$MEDIA" || fail "cannot mount $MEDIA read-only or it has no $SQUASH_DIR/$SQUASHFS"
else
  wait_for_media || {
    dump_media_state
    fail "cannot find the $LABEL boot media"
  }
fi

say "using boot media $MEDIA"

SQUASH_PATH="${MEDIA_MOUNT}${SQUASH_DIR}/${SQUASHFS}"
[ -f "$SQUASH_PATH" ] || fail "missing $SQUASH_PATH on the boot media"
say "squashfs: $SQUASH_PATH ($(du -h "$SQUASH_PATH" | cut -f1))"

# --- copy to RAM when asked -------------------------------------------------
if [ "$TORAM" -eq 1 ]; then
  available_kb=$(awk '/MemTotal/ {print $2}' /proc/meminfo)
  needed_kb=$(( $(du -k "$SQUASH_PATH" | cut -f1) * 2 ))
  if [ "$available_kb" -lt "$needed_kb" ]; then
    fail "zaod.toram=1 needs about $((needed_kb / 1024)) MB of RAM, this machine has $((available_kb / 1024)) MB"
  fi
  say "copying the image to RAM"
  cp "$SQUASH_PATH" "$RD/ram.squashfs" || fail "cannot copy the image to RAM"
  SQUASH_PATH="$RD/ram.squashfs"
fi

# --- mount the image read-only and stack a writable layer -------------------
mount -t squashfs -o ro,loop "$SQUASH_PATH" "$LIVE_ROOT" || fail "cannot mount $SQUASH_PATH"

say "stacking a tmpfs write layer (nothing is written to the media)"
OVERLAY_ACTIVE=1
mount -t overlay overlay \
  -o "lowerdir=$LIVE_ROOT,upperdir=$OVERLAY_ROOT/upper,workdir=$OVERLAY_ROOT/work" \
  "$NEW_ROOT" || {
    say "overlayfs unavailable; continuing with a read-only live root"
    mount --bind "$LIVE_ROOT" "$NEW_ROOT"
    OVERLAY_ACTIVE=0
  }

mount -t tmpfs -o mode=0755 tmpfs "$NEW_ROOT/run" \
  || fail "cannot create a writable /run for the live system"
mkdir -p "$NEW_ROOT/run/zaod/lower" "$NEW_ROOT/run/zaod/upper"
if [ "$OVERLAY_ACTIVE" -eq 1 ]; then
  mount --move "$LIVE_ROOT" "$NEW_ROOT/run/zaod/lower" \
    || fail "cannot preserve the read-only live image mount"
  mount --move "$OVERLAY_ROOT" "$NEW_ROOT/run/zaod/upper" \
    || fail "cannot preserve the live write layer"
fi

if [ "$RESCUE" -eq 1 ]; then
  say "rescue mode: starting a shell inside the live root"
fi
if [ "$INSTALLER" -eq 1 ]; then
  say "installer mode: the session will start the installer"
  echo installer > "$NEW_ROOT/run/zaod/boot-mode"
fi
if [ "$SAFEGFX" -eq 1 ]; then
  echo safegfx > "$NEW_ROOT/run/zaod/boot-mode"
fi

[ -x "$NEW_ROOT/sbin/init" ] || fail "the live image has no executable /sbin/init"
say "kernel $(uname -r), handing over to the live system"
exec switch_root "$NEW_ROOT" /sbin/init
