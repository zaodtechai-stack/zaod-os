#!/bin/sh
# Zaod live-boot init. Runs as PID 1 inside the initramfs.
#
# 1. parse the zaod.* kernel parameters
# 2. find the media carrying the ZAODOS volume label
# 3. loop-mount the squashfs read-only and stack a tmpfs write layer on top
# 4. switch_root into the live system
#
# Every failure path drops to a rescue shell with a message on the console
# instead of hanging, and nothing is ever written to the boot media.

set -eu

LABEL="ZAODOS"
SQUASHFS="zaod-os-x86_64.squashfs"
SQUASH_DIR="/boot/zaod"
MEDIA=""
RD="/run/zaod-init"
LIVE_ROOT="$RD/lower"
OVERLAY_ROOT="$RD/upper"
NEW_ROOT="/newroot"

# /dev/console is the *last* console= on the kernel command line, which on this
# image is ttyS0. On a laptop with no serial port every message this script
# prints is therefore invisible - and so is the rescue shell, which is how a
# missing driver turned into an unexplained "Attempted to kill init" panic.
# Mirror everything to the machine's own screen as well.
SCREEN=/dev/tty0

say() {
  message="$(printf '\033[1;36m[zaod]\033[0m %s' "$*")"
  printf '%s\n' "$message"
  # A serial-only machine has no /dev/tty0; that must never fail the boot.
  if [ -c "$SCREEN" ]; then
    printf '%s\n' "$message" > "$SCREEN" 2>/dev/null
  fi
  return 0
}
fail() {
  message="$(printf '\033[1;31m[zaod] %s\033[0m' "$*")"
  printf '%s\n' "$message" >&2
  for device in "$SCREEN" /dev/console; do
    [ -w "$device" ] || continue
    printf '%s\n' "$message" > "$device" 2>/dev/null
    printf 'Dropping to a rescue shell. The boot media was not modified.\n' > "$device" 2>/dev/null
  done
  trap - EXIT
  # Take the shell to a console that actually has a keyboard behind it.
  if [ -c "$SCREEN" ]; then
    exec /bin/sh <"$SCREEN" >"$SCREEN" 2>&1
  fi
  exec /bin/sh
}

# PID 1 exiting is a kernel panic that explains nothing. Any error that slips
# past a check lands here instead, with the line number.
trap 'fail "unexpected failure while booting (line $LINENO)"' EXIT

TORAM=0
RESCUE=0
SAFEGFX=0
INSTALLER=0

mount -t devtmpfs -o mode=0755 devtmpfs /dev 2>/dev/null || true
mount -t proc proc /proc || fail "cannot mount proc"
mount -t sysfs sysfs /sys || fail "cannot mount sysfs"
# Load the boot stack by name. The kernel autoloads a module by running
# /sbin/modprobe, which only exists once this initramfs provides it, so leaving
# squashfs, loop or overlay to autoload made `mount` fail and dropped the boot
# into the rescue shell. A module that is built in, or simply absent, is not an
# error here: the mount that needs it reports its own failure.
for module in loop squashfs overlay isofs nls_cp437 nls_iso8859-1 nls_utf8 \
              vfat fat sr_mod cdrom sd_mod libata ata_piix ahci virtio_blk \
              usb-storage uas xhci-hcd xhci-pci ehci-hcd ehci-pci ohci-hcd \
              ohci-pci uhci-hcd usbhid hid-generic; do
  modprobe "$module" 2>/dev/null || true
done

# Word-splitting the kernel command line is exactly what is wanted here.
# shellcheck disable=SC2013
for parameter in $(cat /proc/cmdline); do
  case "$parameter" in
    zaod.live=*) : ;;
    zaod.toram=1) TORAM=1 ;;
    zaod.rescue=1) RESCUE=1 ;;
    zaod.safegfx=1) SAFEGFX=1 ;;
    zaod.installer=1) INSTALLER=1 ;;
    zaod.root=*) MEDIA="${parameter#zaod.root=}" ;;
    root=live:LABEL=*) LABEL="${parameter##*LABEL=}" ;;
  esac
done

[ "$SAFEGFX" -eq 1 ] && say "safe graphics requested: kernel modesetting stays off"

mkdir -p "$RD"
mount -t tmpfs -o mode=0755 tmpfs "$RD" || fail "cannot create temporary live workspace"
mkdir -p "$LIVE_ROOT" "$OVERLAY_ROOT" "$NEW_ROOT"
mount -t tmpfs -o mode=0755 tmpfs "$OVERLAY_ROOT" \
  || fail "cannot create temporary overlay write layer"
mkdir -p "$OVERLAY_ROOT/upper" "$OVERLAY_ROOT/work"

# --- locate the media -------------------------------------------------------
MEDIA_MOUNT="/run/zaod/media"
mkdir -p "$MEDIA_MOUNT"

# A device is the boot media when it mounts read-only and carries the image at
# the expected path. The volume label is a hint, not a requirement: the busybox
# blkid in this image cannot read an iso9660 label, so trusting it alone meant a
# correctly built disc never booted. Mounting and checking for the image is the
# test that cannot give a false negative.
try_media() {
  device="$1"
  [ -n "$device" ] || return 1
  [ -e "$device" ] || return 1
  if mount -t iso9660 -o ro "$device" "$MEDIA_MOUNT" 2>/dev/null \
     || mount -t vfat -o ro "$device" "$MEDIA_MOUNT" 2>/dev/null \
     || mount -t auto -o ro "$device" "$MEDIA_MOUNT" 2>/dev/null; then
    if [ -f "$MEDIA_MOUNT$SQUASH_DIR/$SQUASHFS" ]; then
      return 0
    fi
    umount "$MEDIA_MOUNT" 2>/dev/null || true
  fi
  return 1
}

media_candidates() {
  printf '%s\n' "/dev/disk/by-label/$LABEL"
  for device in /dev/sr0 /dev/sr1 /dev/sda /dev/sdb /dev/vda /dev/vdb /dev/nvme0n1; do
    printf '%s\n' "$device"
  done
  for device in /dev/sd? /dev/vd? /dev/sr? /dev/sd?* /dev/vd?* /dev/nvme?n?*; do
    [ -e "$device" ] && printf '%s\n' "$device"
  done
}

wait_for_media() {
  attempt=0
  while [ "$attempt" -lt 30 ]; do
    for candidate in $(media_candidates); do
      if try_media "$candidate"; then
        MEDIA="$candidate"
        return 0
      fi
    done
    attempt=$((attempt + 1))
    say "waiting for the $LABEL media ($attempt/30)"
    sleep 1
  done
  return 1
}

if [ -n "$MEDIA" ]; then
  try_media "$MEDIA" || fail "cannot mount $MEDIA read-only or it has no $SQUASH_DIR/$SQUASHFS"
else
  wait_for_media || fail "cannot find the $LABEL media (block devices: $(find /dev -maxdepth 1 \
    \( -name 'sd?' -o -name 'vd?' -o -name 'sr?' -o -name 'nvme?n?' \) 2>/dev/null | tr '\n' ' '))"
fi

say "using boot media $MEDIA"

SQUASH_PATH="${MEDIA_MOUNT}${SQUASH_DIR}/${SQUASHFS}"
[ -f "$SQUASH_PATH" ] || fail "missing $SQUASH_PATH on the boot media"
say "squashfs: $SQUASH_PATH ($(du -h "$SQUASH_PATH" | cut -f1))"

# --- copy to RAM when asked -------------------------------------------------
if [ "$TORAM" -eq 1 ]; then
  available_kb=$(awk '/MemTotal/ {print $2}' /proc/meminfo)
  needed_kb=$(( $(du -k "$SQUASH_PATH" | cut -f1) * 2 ))
  if [ "$available_kb" -lt "$needed_kb" ]; then
    fail "zaod.toram=1 needs about $((needed_kb / 1024)) MB of RAM, this machine has $((available_kb / 1024)) MB"
  fi
  say "copying the image to RAM"
  cp "$SQUASH_PATH" "$RD/ram.squashfs" || fail "cannot copy the image to RAM"
  SQUASH_PATH="$RD/ram.squashfs"
fi

# --- mount the image read-only and stack a writable layer -------------------
mount -t squashfs -o ro,loop "$SQUASH_PATH" "$LIVE_ROOT" || fail "cannot mount $SQUASH_PATH"

say "stacking a tmpfs write layer (nothing is written to the media)"
OVERLAY_ACTIVE=1
mount -t overlay overlay \
  -o "lowerdir=$LIVE_ROOT,upperdir=$OVERLAY_ROOT/upper,workdir=$OVERLAY_ROOT/work" \
  "$NEW_ROOT" || {
    say "overlayfs unavailable; continuing with a read-only live root"
    mount --bind "$LIVE_ROOT" "$NEW_ROOT"
    OVERLAY_ACTIVE=0
  }

mount -t tmpfs -o mode=0755 tmpfs "$NEW_ROOT/run" \
  || fail "cannot create a writable /run for the live system"
mkdir -p "$NEW_ROOT/run/zaod/lower" "$NEW_ROOT/run/zaod/upper"
if [ "$OVERLAY_ACTIVE" -eq 1 ]; then
  mount --move "$LIVE_ROOT" "$NEW_ROOT/run/zaod/lower" \
    || fail "cannot preserve the read-only live image mount"
  mount --move "$OVERLAY_ROOT" "$NEW_ROOT/run/zaod/upper" \
    || fail "cannot preserve the live write layer"
fi

if [ "$RESCUE" -eq 1 ]; then
  say "rescue mode: starting a shell inside the live root"
fi
if [ "$INSTALLER" -eq 1 ]; then
  say "installer mode: the session will start the installer"
  echo installer > "$NEW_ROOT/run/zaod/boot-mode"
fi
if [ "$SAFEGFX" -eq 1 ]; then
  echo safegfx > "$NEW_ROOT/run/zaod/boot-mode"
fi

[ -x "$NEW_ROOT/sbin/init" ] || fail "the live image has no executable /sbin/init"
say "handing over to the live system"
exec switch_root "$NEW_ROOT" /sbin/init
